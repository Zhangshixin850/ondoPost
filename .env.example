# Copy this file to .env and fill in both API credentials.
ONDO_API_KEY_ID=
ONDO_API_SECRET=
ONDO_API_URL=https://api.ondoperps.xyz
ONDO_TIMEOUT=10
# Shared REST requests per second; restart after changing.
rps=5

symbol1=CRCL
symbol2=SNDK
# Empty symbol slots are disabled.
symbol3=
orderSize=1000
myLimit=5000
nearLimit=2
farLimit=4.9

# Reverse-order offset in bps.
verse=3
# Account margin ratio limit: 0.2 = 20%.
MMR=0.2
# Account effective leverage limit.
leverage=5

LOG_LEVEL=INFO
