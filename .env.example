# Copy this file to .env and fill in both API credentials.
ONDO_API_KEY_ID=
ONDO_API_SECRET=
ONDO_API_URL=https://api.ondoperps.xyz
ONDO_TIMEOUT=10

symbol1=CRCL
symbol2=SNDK
symbol3=SOXL
orderSize=1000
myLimit=5000

