# Copy this file to .env and fill in both API credentials.
ONDO_API_KEY_ID=
ONDO_API_SECRET=
ONDO_API_URL=https://api.ondoperps.xyz
ONDO_TIMEOUT=10
# v2.0: placement and cancellation each have an independent 2 requests/s limit.

symbol1=CRCL
orderSize1=1000
myLimit1=5000
symbol2=SNDK
orderSize2=1000
myLimit2=5000
# Empty symbol slots are disabled.
symbol3=SOXL
orderSize3=1000
myLimit3=5000

# Full depth WS; quote one tick behind the largest external level, within 5 bps.
# Account margin ratio limit: 0.2 = 20%.
MMR=0.2
# Account effective leverage limit.
leverage=5

LOG_LEVEL=INFO
