# Copy this file to .env and fill in both API credentials.
ONDO_API_KEY_ID=
ONDO_API_SECRET=
ONDO_API_URL=https://api.ondoperps.xyz
ONDO_TIMEOUT=10
# v2.1: placement and cancellation each have an independent 2 requests/s limit.

symbol1=CRCL
orderSize1=1000
myLimit1=5000
symbol2=SNDK
orderSize2=1000
myLimit2=5000
# Empty symbol slots are disabled.
symbol3=SOXL
orderSize3=1000
myLimit3=5000

# Full depth WS; quote one tick behind, or at the wall if that tick exceeds 5 bps.
# Same-level quotes require external quantity >= 50% of the remaining own quantity.
# Keep the current wall; switch after a 25% advantage sustained for 500 ms.
wallSwitchRatio=1.25
wallConfirmMs=500
# Account margin ratio limit: 0.2 = 20%.
MMR=0.2
# Account effective leverage limit.
leverage=5

LOG_LEVEL=INFO
